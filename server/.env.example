# Copy this file to .env and fill in real values. .env is gitignored.

PORT=
MONGO_URI=
# Frontend origin: used for CORS and the PayPal return/cancel URLs
CLIENT_URL=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# PayPal: developer.paypal.com > Apps & Credentials > (Sandbox tab) > your app
PAYPAL_MODE=sandbox            # "sandbox" for testing, "live" for real money
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Same app > Webhooks > Add webhook (URL: https://<public-host>/api/paypal/webhook)
# then copy the Webhook ID shown in the list
PAYPAL_WEBHOOK_ID=

# Used only by `npm run seed` to create the first admin account
SEED_ADMIN_USERNAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
